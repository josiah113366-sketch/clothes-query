# Rendering example: storage/topics/partitions are NOT approved deployment sizing.
# Only the initial 24-hour retention is approved.
# Copy to ignored runtime.local.yaml and replace all example contracts.
kafka:
  enabled: true
  storageGi: 100
  retentionHours: 24
  clientNamespaces: [example-consumer]
topics:
  - name: example-orders
    partitions: 3
    # 24 hours for delete-policy business topics; confirm each real topic contract.
    retentionMs: 86400000
clients:
  - name: example-consumer
    produceTopics: []
    consumeTopics: [example-orders]
    consumerGroups: [example-consumer]
connect:
  enabled: false
  image: ""
  produceTopics: [example-orders]
