{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kafka": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        },
        "version": {
          "const": "4.3.1"
        },
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
        },
        "replicas": {
          "type": "integer",
          "enum": [
            1,
            3
          ]
        },
        "storageClass": {
          "const": "clothes-query-kafka-gp3"
        },
        "storageGi": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            }
          ]
        },
        "retentionHours": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 8760
            }
          ]
        },
        "nodePool": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(m)?$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(Mi|Gi)$"
                }
              },
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(m)?$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(Mi|Gi)$"
                }
              },
              "required": [
                "cpu",
                "memory"
              ]
            }
          },
          "required": [
            "requests",
            "limits"
          ]
        },
        "heapMi": {
          "type": "integer",
          "minimum": 128,
          "maximum": 32768
        },
        "clientNamespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "enabled",
        "name",
        "version",
        "image",
        "replicas",
        "storageClass",
        "nodePool",
        "resources",
        "heapMi",
        "clientNamespaces"
      ]
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,248}$",
            "maxLength": 249
          },
          "partitions": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "retentionMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31536000000
          },
          "resourceName": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
          }
        },
        "required": [
          "name",
          "partitions",
          "retentionMs"
        ]
      },
      "uniqueItems": true
    },
    "clients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
          },
          "produceTopics": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,248}$",
              "maxLength": 249
            },
            "uniqueItems": true
          },
          "consumeTopics": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,248}$",
              "maxLength": 249
            },
            "uniqueItems": true
          },
          "consumerGroups": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "produceTopics",
          "consumeTopics",
          "consumerGroups"
        ]
      },
      "uniqueItems": true
    },
    "connect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "image": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
            }
          ]
        },
        "produceTopics": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,248}$",
            "maxLength": 249
          },
          "uniqueItems": true
        },
        "consumeTopics": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,248}$", "maxLength": 249},
          "uniqueItems": true
        },
        "consumerGroups": {
          "type": "array",
          "items": {"type": "string", "maxLength": 63, "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"},
          "uniqueItems": true
        },
        "databaseSecret": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        },
        "rdsCaSecret": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(m)?$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(Mi|Gi)$"
                }
              },
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(m)?$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(Mi|Gi)$"
                }
              },
              "required": [
                "cpu",
                "memory"
              ]
            }
          },
          "required": [
            "requests",
            "limits"
          ]
        },
        "heapMi": {
          "type": "integer",
          "minimum": 128,
          "maximum": 32768
        }
      },
      "required": [
        "enabled",
        "name",
        "replicas",
        "image",
        "produceTopics",
        "databaseSecret",
        "rdsCaSecret",
        "resources",
        "heapMi"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "lagExporter"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "lagExporter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "topicRegex",
            "groupRegex",
            "resources"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "topicRegex": {
              "type": "string",
              "maxLength": 1024
            },
            "groupRegex": {
              "type": "string",
              "maxLength": 1024
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "requests": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cpu": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*(m)?$"
                    },
                    "memory": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*(Mi|Gi)$"
                    }
                  },
                  "required": [
                    "cpu",
                    "memory"
                  ]
                },
                "limits": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cpu": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*(m)?$"
                    },
                    "memory": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*(Mi|Gi)$"
                    }
                  },
                  "required": [
                    "cpu",
                    "memory"
                  ]
                }
              },
              "required": [
                "requests",
                "limits"
              ]
            }
          }
        }
      }
    },
    "profile": {
      "type": "string",
      "enum": [
        "standard",
        "single-node"
      ]
    }
  },
  "required": [
    "kafka",
    "topics",
    "clients",
    "connect",
    "metrics",
    "profile"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "single-node"
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "kafka": {
            "properties": {
              "replicas": {
                "const": 1
              }
            }
          },
          "connect": {
            "properties": {
              "replicas": {
                "const": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "kafka": {
            "properties": {
              "replicas": {
                "const": 3
              }
            }
          },
          "connect": {
            "properties": {
              "replicas": {
                "minimum": 2
              }
            }
          }
        }
      }
    }
  ]
}
