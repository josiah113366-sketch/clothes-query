# Copy to deployment.local.tfvars (ignored by Git).
# Set TF_VAR_expected_account_id privately. Do not put credentials in tfvars.
# Set TF_VAR_state_bucket privately to the existing bootstrap bucket.
kubernetes_version = "1.36"
# Named administrators who may assume the dedicated EKS role.
admin_trusted_principal_arns = ["REPLACE_WITH_APPROVED_USER_OR_ROLE_ARN"]
# Optional extra existing administrator roles; usually leave empty.
admin_role_arns = []
public_access_cidrs = ["REPLACE_WITH_ADMIN_PC_PUBLIC_IPV4/32"]
# Preserve approved team networks here; do not replace this list with /0.
# Temporary development only: true opens the EKS public API to all IPv4.
# Set false and apply to restore public_access_cidrs. This does not change IAM/RBAC.
allow_public_api_from_anywhere = false
