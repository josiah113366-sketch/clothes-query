# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git 에 올라가지 않음)
# 모든 항목은 비워 두면 기본값을 씁니다. 각 항목 설명은 src/rsim/common/config.py 참고.
# 공개 저장소라 실제 키·계정 정보는 절대 이 파일에 쓰지 않는다.

# ---- Bedrock
# 팀 결정: 도쿄 리전
AWS_REGION=ap-northeast-1
# Bedrock API 키 (필수, --llm fake 일 때만 비워도 됨). AWS 계정 권한이 없어도 된다.
# 키는 절대 저장소/노션에 올리지 말고 .env 에만 둔다.
AWS_BEARER_TOKEN_BEDROCK=
# 2026-10-13 벤치마크로 확정: google.gemma-3-12b-it (다른 후보는 src/rsim/common/config.py 주석 참고)
BEDROCK_MODEL_ID=google.gemma-3-12b-it
# 생성 온도 (0.5~1.0)
BEDROCK_TEMPERATURE=0.8
# 검수 루프에서 실패한 리뷰(속성 누락·감성 차이)를 다시 생성하는 횟수 (0 = 바로 버림). 재생성도 호출 비용이 든다.
ASPECT_RETRIES=1
# 검수 모델 (배치마다 검수 호출 1번). 비우면 BEDROCK_MODEL_ID 와 같은 모델
VERIFIER_MODEL_ID=
# Bedrock 1회 호출당 리뷰 수 (5~10 권장)
BATCH_SIZE=5
# 프롬프트에 넣을 말투 예시 수
FEW_SHOT_K=8

# ---- Kafka
# 윈도우에서 직접 실행: localhost:9092 / docker compose 안에서 실행: kafka:29092 (compose 가 자동 설정)
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=reviews.raw
# 정답(학습·채점용) 토픽. none 이면 보내지 않음
KAFKA_TRUTH_TOPIC=reviews.truth
KAFKA_PARTITIONS=3

# ---- 데이터 (review-simulator 폴더 기준 상대 경로)
SEEDS_PATH=.local/seeds.jsonl
PRODUCTS_PATH=data/products.csv
INCIDENTS_PATH=data/incidents.json

# 같은 값이면 같은 상품·별점·속성·ID 순서가 재현됨 (비우면 매번 새로 만들고 로그에 남김)
RANDOM_SEED=
