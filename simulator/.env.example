# 로컬 전용 더미 값이다. 실제 접속 정보는 .env에 두고 커밋하지 않는다.
DATABASE_URL=postgresql://sim:sim@localhost:5432/clothes
SIM_SEED=42
SIM_REGION_FILE=data/region_weights_202609.csv
CONNECT_URL=http://localhost:8083
KAFKA_BOOTSTRAP=localhost:29092
# Kafka TLS (로컬은 PLAINTEXT라 쓰지 않는다. EKS Kafka에 붙을 때만, 아래는 더미 경로)
# KAFKA_SECURITY_PROTOCOL=SSL
# KAFKA_SSL_CA_FILE=/path/to/ca.pem
# KAFKA_SSL_CERT_FILE=/path/to/client.pem
# KAFKA_SSL_KEY_FILE=/path/to/client.key
# 클릭 로그 출력 (none | jsonl | kafka)
# SIM_CLICK_SINK=none
S3_BUCKET=example-bucket-name
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=dummy-access-key-id
AWS_SECRET_ACCESS_KEY=dummy-secret-access-key
SEED_DIR=.local/seed_v2
